# 이 파일을 .env로 복사한 뒤 실제 값을 채우세요. .env는 GitHub에 올라가지 않습니다.
# 이 파일(.env.example)에는 실제 키를 넣지 마세요. GitHub에 그대로 공개됩니다.
LLM_API_KEY=
# Timely API (2026-11-18 옛 주소 .../chat/bridge/openai 종료). 모델 이름에 접두사(anthropic/ 등)를 붙이지 않음
# Claude: 주소 https://hello.timelyai.io/api/v2/chat/direct/anthropic , 모델 claude-haiku-4-5
# GPT:    주소 https://hello.timelyai.io/api/v2/chat/direct/openai/v1 , 모델 예: gpt-5-mini
LLM_BASE_URL=https://hello.timelyai.io/api/v2/chat/direct/anthropic
LLM_MODEL=claude-haiku-4-5
# 샘플링 온도. 0이면 같은 입력에 같은 답이 나올 가능성이 높아짐 (GitHub에서는 Variables의 LLM_TEMPERATURE)
LLM_TEMPERATURE=0
# 선택: 개인 GitHub 토큰 (없어도 되지만 API 제한이 시간당 60회로 줄어듭니다)
GITHUB_TOKEN=
